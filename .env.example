# Read by src/rag/config.py (pydantic-settings). Names are case-insensitive.
# Copy to .env and fill in. .env is gitignored.

# Where papers, parses, the SQLite db (rag.db) and indexes live. Default: <repo>/data
# DATA_DIR=

# Which LLM the pipeline uses: ollama | groq
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
# Read timeout per request; connect timeout is fixed at 5s.
LLM_TIMEOUT_SECONDS=120
# Retries on connection errors and on 429/5xx responses.
LLM_MAX_RETRIES=3

# --- Ollama (default, local, $0) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Groq (optional, free tier) ---
# Required only when LLM_PROVIDER=groq.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
