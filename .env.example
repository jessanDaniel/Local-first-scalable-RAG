# LLM provider selection. The RAG pipeline depends on the LLM interface
# (src/llm/interface.py), never on a specific provider — this is just config.
LLM_PROVIDER=ollama

# --- Ollama (default, local, $0 cost) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Optional hosted providers (free tier only, never required) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=

# GROQ_API_KEY=
# GROQ_MODEL=

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval defaults ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_PERCENT=10
TOP_K=3
